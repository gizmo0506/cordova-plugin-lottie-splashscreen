{
  "name": "cordova-plugin-lottie-splashscreen",
  "version": "0.11.1",
  "description": "Apache Cordova plugin to show Lottie animations as the splash screen — Capacitor 8 compatible (SPM + Cordova bridge)",
  "author": "Tim Brust <github@timbrust.de>",
  "license": "MIT",
  "types": "./types/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "types/",
    "plugin.xml",
    "Package.swift",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "husky",
    "build": "tsc",
    "lint": "npm run lint:typescript",
    "lint:all": "npm run lint:android && npm run lint:ios && npm run lint:typescript",
    "lint:android": "node scripts/check-cli.mjs ktlint src/android",
    "lint:ios": "node scripts/check-cli.mjs swiftlint",
    "lint:typescript": "eslint 'www/**/*.ts'",
    "prepublishOnly": "npm run build",
    "release": "standard-version -s -a"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-angular": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/cordova": "^11.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    }
  },
  "capacitor": {
    "ios": {
      "packageManager": "SPM"
    }
  },
  "cordova": {
    "id": "cordova-plugin-lottie-splashscreen",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "engines": {
    "cordovaDependencies": {
      ">=0.8.0": {
        "cordova": ">= 9.0.0",
        "cordova-android": ">=8.0.0",
        "cordova-ios": ">=5.0.0",
        "apple-ios": ">=9.0.0"
      },
      ">=0.9.0": {
        "cordova": ">= 9.0.0",
        "cordova-android": ">=9.0.0",
        "cordova-ios": ">=5.0.0",
        "apple-ios": ">=9.0.0"
      },
      ">=0.10.0": {
        "cordova": ">= 9.0.0",
        "cordova-android": ">=9.0.0",
        "cordova-ios": ">=5.0.0",
        "apple-ios": ">=11.0.0"
      },
      ">=0.11.0": {
        "cordova": ">= 9.0.0",
        "cordova-android": ">=10.0.0",
        "cordova-ios": ">=8.0.0",
        "apple-ios": ">=15.0.0"
      }
    }
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "cordova",
    "cordova-plugin",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "lottie",
    "lottie-android",
    "lottie-ios",
    "bodymovin",
    "splashscreen",
    "swift",
    "kotlin"
  ],
  "repository": "timbru31/cordova-plugin-lottie-splashscreen",
  "bugs": {
    "url": "https://github.com/timbru31/cordova-plugin-lottie-splashscreen/issues"
  },
  "funding": "https://github.com/sponsors/timbru31"
}
